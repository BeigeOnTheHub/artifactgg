# The SPA lives at the site root (see vite.config.ts `base: '/'`). Map images
# can get swapped in place under the same filename (kiiro is mid-rework), so
# they must revalidate rather than be cached immutable -- otherwise a new map
# never reaches anyone who already loaded the old one. The recheck is cheap
# (ETag gives a 304 when nothing changed). JS/CSS bundles are content-hashed so
# they stay immutable below. The HTML must stay fresh so updates roll out.

/assets/maps/*
  Cache-Control: public, no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Security headers applied to every response. Cloudflare Pages / Netlify
# merge headers from matching sections, so the cache rules above still apply.
#
# style-src and script-src are strict 'self': no inline <style> or style="" in
# the build (CSSOM setters like el.style.cssText are fine, CSP ignores them) and
# vite emits external modules only. connect-src 'self' is free, the app makes no
# cross-origin fetches. frame-ancestors 'none' stops the app being iframed into
# a phishing page to harvest strats.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
