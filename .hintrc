{
  "extends": ["web-recommended"],
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ],
  "hints": {
    "compat-api/css": ["default", {
      "ignore": [
        "scrollbar-width",
        "scrollbar-color"
      ]
    }]
  }
}
